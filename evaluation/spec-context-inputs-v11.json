  "recorder_source": "\"\"\"Compare source payloads/prompts without loading weights or changing the app.\"\"\"\nimport hashlib\nimport json\nimport subprocess\nimport sys\nimport types\nfrom pathlib import Path\n\nroot = Path(__file__).resolve().parents[2] / 'carebridge-ai'\nsys.path.insert(0,str(root))\nfrom app.carebridge.guidance import translation_payload\nfrom app.carebridge.provider import translation_system_prompt\nfrom app.carebridge.safety import check_input\n\nbaseline_ref = '0ab3097'\ndef previous(path):\n    return subprocess.check_output(['git','show',f'{baseline_ref}:{path}'],cwd=root).decode('utf-8')\n# The system-rendering function itself is unchanged; only derived hints differ.\nassert previous('app/carebridge/provider.py').replace('\\r\\n','\\n') == (root/'app/carebridge/provider.py').read_text(encoding='utf-8')\nmodule = types.ModuleType('prior_guidance')\nexec(compile(previous('app/carebridge/guidance.py'),'<prior_guidance>','exec'),module.__dict__)\ncorpus_raw=(root/'evaluation/translation-corpus-v7.json').read_bytes()\ncorpus=json.loads(corpus_raw)\nrows=[]\nfor c in corpus['translation_cases']:\n    segments=check_input(c['source'])\n    before=module.translation_payload(segments,c['language'])\n    after=translation_payload(segments,c['language'])\n    def signature(payload):\n        return hashlib.sha256(json.dumps(dict(system=translation_system_prompt(payload),payload=payload),ensure_ascii=False,sort_keys=True).encode()).hexdigest()\n    rows.append(dict(id=c['id'],unchanged=signature(before)==signature(after),previous_sha256=signature(before),candidate_sha256=signature(after)))\nresult=dict(schema='carebridge.model-input-comparison.v1',baseline_ref=baseline_ref,\n    candidate_ref=subprocess.check_output(['git','rev-parse','HEAD'],cwd=root).decode().strip(),\n    corpus_sha256=hashlib.sha256(corpus_raw).hexdigest(),\n    count=len(rows),unchanged=sum(r['unchanged'] for r in rows),\n    changed_ids=[r['id'] for r in rows if not r['unchanged']],\n    scope='Exact source payload and system prompt comparison, independent of global pipeline hashes. Does not prove generated output equivalence.',\n    cases=rows,recorder_source=Path(__file__).read_text(encoding='utf-8'))\nwith (root/'evaluation/spec-context-inputs-v11.json').open('x',encoding='utf-8',newline='\\n') as f:\n    json.dump(result,f,ensure_ascii=False,indent=2)\n    f.write('\\n')\nprint(json.dumps({k:result[k] for k in ('count','unchanged','changed_ids')},ensure_ascii=False))\n"
