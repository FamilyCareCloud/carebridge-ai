FCC_AI_BASE_MODEL=openai/whisper-small
FCC_AI_ADAPTER_PATH=models/whisper-senior-lora
FCC_AI_DEVICE=cuda
FCC_AI_LANGUAGE=korean
FCC_AI_TASK=transcribe
FCC_AI_HOST=0.0.0.0
FCC_AI_PORT=8000
# 터널로 공인 노출할 때 설정. 비워두면 /transcribe에 인증을 요구하지 않습니다(로컬 전용 실행 가정).
FCC_AI_API_KEY=

# false이면 torch/Whisper/LoRA 없이 텍스트 초안 API만 실행합니다.
FCC_AI_STT_ENABLED=true
FCC_AI_MAX_AUDIO_BYTES=4194304
# Whisper 문맥 길이를 넘는 오디오는 자동 절단하지 않고 413으로 거절합니다(최대 30초).
FCC_AI_MAX_AUDIO_SECONDS=30

# 비한국어·혼합언어 메모용 OpenAI-compatible chat completions 모델.
# 한국어 원문 보존 모드는 외부 모델 없이 동작합니다.
# 외부 서비스는 HTTPS, 로컬 모델 서버는 http://127.0.0.1:... 사용 가능.
FCC_AI_CAREBRIDGE_MODEL_URL=
FCC_AI_CAREBRIDGE_MODEL=
FCC_AI_CAREBRIDGE_MODEL_API_KEY=
FCC_AI_CAREBRIDGE_TIMEOUT_SECONDS=30

# 로컬 GPU 번역/의미 검사. 사용법: docs/LOCAL_GPU.md
FCC_AI_CAREBRIDGE_BACKEND=http
FCC_AI_CAREBRIDGE_LOCAL_MODEL=unsloth/Qwen3-8B-unsloth-bnb-4bit
FCC_AI_CAREBRIDGE_LOCAL_FILES_ONLY=true
FCC_AI_CAREBRIDGE_PRELOAD=false
FCC_AI_CAREBRIDGE_LOCAL_MAX_INPUT_TOKENS=8192
FCC_AI_CAREBRIDGE_LOCAL_MAX_NEW_TOKENS=2048
FCC_AI_CAREBRIDGE_QUEUE_TIMEOUT_SECONDS=2
FCC_AI_CAREBRIDGE_SEMANTIC_CHECK_ENABLED=false
